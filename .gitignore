__pycache__/
*.pyc
.pytest_cache/
build/
dist/
# ShatteredGamingOverlay.spec is a real, hand-crafted PyInstaller build
# input (see build-agent's ShatteredGamingOverlay.spec), not throwaway
# boilerplate -- explicitly un-ignored below so it's actually tracked.
*.spec
!ShatteredGamingOverlay.spec
# Inno Setup build output (ShatteredGamingOverlay_Setup.exe,
# ShatteredGamingOverlay_v*.zip) -- large binaries produced by build.bat,
# same "don't commit build output" convention as build/ and dist/ above.
installer/
profiles.json
settings.json
.venv/
venv/
*.log

# Hello ImGui's per-window-title runtime geometry/layout cache (imgui.ini
# equivalent) -- regenerated on launch, not source.
*.ini

# Agent behavior rules -- local to this machine, not shared project config.
agent-rules.md
